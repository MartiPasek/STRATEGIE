{
    email m.pasek@eurosoft.com
}

strategie-ai.com, www.strategie-ai.com, app.strategie-ai.com, api.strategie-ai.com {
    # Phase HA-1 Blue-Green (23.5.2026):
    #   - localhost:8002 = STRATEGIE-API (primary, aktualni kod z C:\Projekty\STRATEGIE)
    #   - localhost:8003 = STRATEGIE-API-B (secondary, day-old snapshot z C:\Projekty\STRATEGIE-prev)
    # lb_policy first = primary preferred 100%, secondary only on primary fail
    reverse_proxy localhost:8002 localhost:8003 {
        lb_policy first
        health_uri /api/v1/health
        health_interval 3s
        health_timeout 2s
        health_status 2xx
        fail_duration 10s
        max_fails 1
        header_up Host {host}
        header_up X-Real-IP {remote_host}
    }

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }

    log {
        output file C:/caddy/logs/access.log {
            roll_size 10MB
            roll_keep 5
        }
        format json
    }
}
