Windows Registry Editor Version 5.00

; EUROSOFT Directory Protocol — registrace pro CELÝ POČÍTAČ (admin / GPO)
; Handler musí ležet v: C:\ProgramData\EurosoftDir\eurosoftdir_open.vbs

[HKEY_LOCAL_MACHINE\Software\Classes\eurosoftdir]
@="URL:EUROSOFT Directory Protocol"
"URL Protocol"=""

[HKEY_LOCAL_MACHINE\Software\Classes\eurosoftdir\DefaultIcon]
@="explorer.exe,0"

[HKEY_LOCAL_MACHINE\Software\Classes\eurosoftdir\shell\open\command]
@="wscript.exe \"C:\\ProgramData\\EurosoftDir\\eurosoftdir_open.vbs\" \"%1\""
